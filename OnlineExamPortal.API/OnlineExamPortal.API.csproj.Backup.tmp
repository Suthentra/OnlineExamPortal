<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="8.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" /> 
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="Helpers\" />
    <Folder Include="Middleware\" />
    <Folder Include="Models\DTOs\Answer\" />
    <Folder Include="Models\DTOs\ExamAttempt\" />
    <Folder Include="Models\DTOs\NewFolder\" />
    <Folder Include="Models\DTOs\Question\" />
    <Folder Include="Services\" />
  </ItemGroup>

</Project>
